# ============================================================
# SIM-BK PRO | Konfigurasi Supabase
# Salin file ini ke .env.local dan isi dengan kredensial Anda
# ============================================================

# URL Project Supabase Anda
# Contoh: https://xyzabcdef.supabase.co
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon/Public Key dari Project Settings > API
# Contoh: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Opsional: URL Edge Function portal siswa.
# Default: <VITE_SUPABASE_URL>/functions/v1/student-portal
# VITE_STUDENT_PORTAL_URL=https://your-project-ref.supabase.co/functions/v1/student-portal
